# Keep the build context small and keep secrets out of the image.
.git
.github
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache

# secrets: never copied into an image
.env
.env.*
!.env.example

# data, experiment output and docs are not needed to run the app
data
runs
reports
mlruns
mlartifacts
tests
*.md

# only the champion model may enter the build context (used by the 'api' stage)
models/*
!models/champion.keras
