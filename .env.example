# Copy this file to .env and fill it in. .env is git-ignored - NEVER commit real values.

# --- DagsHub (code, data and experiment tracking) ---
DAGSHUB_USERNAME=SilverUmer21
DAGSHUB_REPO=23L0682_A2_Ops
# Create at: DagsHub -> your avatar -> Settings -> Tokens
DAGSHUB_TOKEN=

# --- MLflow on DagsHub (the code maps username/token onto MLFLOW_TRACKING_USERNAME/PASSWORD) ---
MLFLOW_TRACKING_URI=https://dagshub.com/SilverUmer21/23L0682_A2_Ops.mlflow

# --- Docker Compose: database ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=
POSTGRES_DB=visionguard

# --- Web app (read by docker-compose.yml) ---
THRESHOLD=0.6362
MODEL_NAME=23L0682_A2_Ops
MODEL_VERSION=2
MAX_UPLOAD_MB=5

# --- Remote model API (Tasks 7-8). Leave INFERENCE_URL empty to use the model in the container ---
INFERENCE_URL=
INFERENCE_API_KEY=
# secret key that the cloud model API demands from callers (set it in the cloud app's settings, not in code)
API_KEY=
